{
  "name": "psi-zero-day",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "npm run assets:vector && npm run assets:manifest",
    "dev": "vite",
    "pretest": "npm run assets:vector && npm run assets:manifest",
    "test": "vitest run",
    "prebuild": "npm run assets:vector && npm run assets:manifest",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.engine.json",
    "assets:vector": "node scripts/generate-episode01-vector-art.mjs",
    "assets:manifest": "node scripts/build-episode01-assets.mjs",
    "assets:check": "node scripts/generate-episode01-vector-art.mjs --check && node scripts/build-episode01-assets.mjs --check",
    "release:check": "npm run assets:vector && npm run assets:manifest && npm run assets:check && npm test && npm run typecheck && npm run build",
    "android:add": "npm run build && npx cap add android && npm run android:configure",
    "android:sync": "npm run build && npx cap sync android && npm run android:configure",
    "android:configure": "node scripts/configure-android.mjs",
    "android:open": "npx cap open android",
    "android:doctor": "npx cap doctor"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "phaser": "4.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
