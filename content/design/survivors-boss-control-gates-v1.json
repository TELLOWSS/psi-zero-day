{
  "id": "survivors-boss-control-gates-v1",
  "version": "1.0.0",
  "status": "SOURCE_SEMANTICS_ONLY",
  "gateVocabulary": [
    {
      "id": "STOP_WORK",
      "description": "작업/장비를 즉시 안전정지 상태로 전환"
    },
    {
      "id": "EVACUATE_ZONE",
      "description": "위험반경 내 인원을 대피시키고 진입을 차단"
    },
    {
      "id": "SEPARATE_ROUTE",
      "description": "차량/자재/보행 또는 공종 동선을 물리적으로 분리"
    },
    {
      "id": "ESTABLISH_SPOTTER",
      "description": "신호수·유도원 또는 명확한 시야 연결을 확보"
    },
    {
      "id": "LOCKOUT_TAGOUT",
      "description": "에너지원 차단·잠금·표시"
    },
    {
      "id": "VERIFY_ZERO_ENERGY",
      "description": "검전/압력/운동 등 제로에너지 상태를 실제 확인"
    },
    {
      "id": "ISOLATE_STORAGE",
      "description": "가연물·용제·위험물 보관구역을 격리"
    },
    {
      "id": "VENTILATE_MEASURE",
      "description": "환기 후 계측으로 안전농도를 확인"
    },
    {
      "id": "RESTORE_GUARD",
      "description": "난간·덮개·가드·작업발판 등 집단방호를 복구"
    },
    {
      "id": "VERIFY_RIGGING",
      "description": "슬링·샤클·인양점·체결·하중상태를 확인"
    },
    {
      "id": "STABILIZE_LOAD",
      "description": "쐐기·받침·임시고정·결속 등으로 전도/이동을 안정화"
    },
    {
      "id": "SHORE_SUPPORT",
      "description": "동바리·버팀·임시지지로 하중경로를 확보"
    },
    {
      "id": "CLEAR_BELOW",
      "description": "낙하/양중 하부 작업자를 0명으로 만들고 출입을 통제"
    },
    {
      "id": "HANDOFF_CONFIRM",
      "description": "담당·잔여위험·재개조건을 기록하고 상대 팀 확인응답까지 완료"
    },
    {
      "id": "VERIFY_EGRESS",
      "description": "실제 피난/대피 통로가 연속적으로 확보됐는지 확인"
    },
    {
      "id": "DEPRESSURIZE_VERIFY",
      "description": "잔압을 제거하고 압력 0을 계측으로 확인"
    },
    {
      "id": "ISOLATE_LINE",
      "description": "배관/유체 계통의 상하류·바이패스를 식별해 격리"
    },
    {
      "id": "DRAIN_DRY_AREA",
      "description": "침수/고임수를 제거하고 전기 작업면을 건조·분리"
    },
    {
      "id": "ESTABLISH_SAFE_ACCESS",
      "description": "사다리/작업대/승강 접근을 안정화하고 하부를 통제"
    }
  ],
