        "initial": { "expression": "attentive", "posture": "careful", "items": ["item.safety_tablet"] },
        "focused": { "expression": "resolved", "posture": "decisive", "items": ["item.safety_tablet", "item.inspection_camera"] },
        "skilled": { "expression": "calm_confident", "posture": "commanding", "items": ["item.safety_tablet", "item.inspection_camera", "item.stopwork_card"] }
      }
    },
    "kang_taesik": {
      "stage_flag": "growth.kang_taesik",
