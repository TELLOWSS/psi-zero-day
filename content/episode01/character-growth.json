        "initial": { "expression": "guarded", "posture": "arms_folded", "items": ["item.work_gloves"] },
        "focused": { "expression": "engaged", "posture": "directing", "items": ["item.work_gloves", "item.foreman_radio"] },
        "skilled": { "expression": "trusting", "posture": "mentoring", "items": ["item.work_gloves", "item.foreman_radio", "item.tbm_board"] }
      }
    },
    "yoon_sungho": {
