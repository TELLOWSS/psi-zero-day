{
  "schema_version": 1,
  "policy": {
    "identity_locked": true,
    "age_visual_change": false,
    "growth_changes": ["expression", "posture", "equipment", "confidence"],
    "stage_order": ["initial", "focused", "skilled"]
  },
  "characters": {
